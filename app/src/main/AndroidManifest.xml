<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Berechtigungen (Begründungen: docs/BERECHTIGUNGEN.md)
        - Speicherkapazität, Akku, Thermalstatus, Geräteinformationen, Sensoren: ohne Berechtigung.
        - MANAGE_EXTERNAL_STORAGE („Zugriff auf alle Dateien“): Dateimanager für alle Ordner und Dateitypen,
          Schreiben auf SD-Karten und USB-Speicher. Der Nutzer erteilt sie selbst in den Android-Einstellungen;
          ORBIT öffnet die Seite nur auf Tippen nach einer Erklärung. Private App ohne Play-Store-Veröffentlichung.
        - REQUEST_INSTALL_PACKAGES: nur damit ein angetipptes App-Paket (APK) an den Android-Installer übergeben
          werden kann. Android fragt zusätzlich selbst, ob ORBIT Apps installieren darf.
        - ACCESS_FINE_LOCATION / ACCESS_COARSE_LOCATION: nur für Geschwindigkeit, Höhe und Satelliten in
          „Gerät › Bewegung“, nur solange diese Ansicht offen ist; kein Standort im Hintergrund, nichts wird
          gespeichert oder gesendet.
        - FOREGROUND_SERVICE(_DATA_SYNC), POST_NOTIFICATIONS: lange Dateivorgänge (Kopieren, Verschieben …) laufen
          weiter, wenn man die App kurz verlässt, mit Fortschritt in einer Benachrichtigung.
        Bewusst NICHT deklariert: INTERNET – ORBIT kann keine Daten senden.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature
        android:name="android.hardware.location.gps"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.barometer"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.sensor.compass"
        android:required="false" />

    <application
        android:name=".AetherApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Aether">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Lange Dateivorgänge (Kopieren, Verschieben, Komprimieren …) laufen als Vordergrunddienst weiter, wenn man
            die App verlässt – mit Fortschritt und „Abbrechen“ in der Benachrichtigung. Er läuft nur, solange ein
            Vorgang läuft, und beendet sich danach selbst. Nicht exportiert: keine andere App kann ihn starten.
        -->
        <service
            android:name=".operations.FileOperationService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
            Übergibt einzelne Dateien an andere Apps (Öffnen, Teilen, Installieren) als content://-Adresse. Nicht
            exportiert; eine App erhält nur für die eine übergebene Datei eine zeitlich begrenzte Leseberechtigung.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>
    </application>
</manifest>
